{
  "name": "opencode-sessions-all",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin: all sessions from all projects, grouped by project, in the sidebar",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "src",
    "tui.js",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
