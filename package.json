    "@opentui/core": ">=0.5.14",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.24",
    "@opentui/core": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "esbuild-plugin-solid": "^0.5.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.8.0"
  }
}